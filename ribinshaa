<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Portfolio</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f4f4;
    color:#333;
}

header{
    background:#222;
    color:#fff;
    padding:20px 10%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header nav a{
    color:#fff;
    text-decoration:none;
    margin-left:20px;
    transition:.3s;
}

header nav a:hover{
    color:#00bcd4;
}

.hero{
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    height:80vh;
    text-align:center;
    background:linear-gradient(135deg,#00bcd4,#3f51b5);
    color:white;
}

.hero h1{
    font-size:48px;
}

.hero p{
    margin:15px 0;
    font-size:20px;
}

.btn{
    padding:12px 25px;
    background:white;
    color:#3f51b5;
    text-decoration:none;
    border-radius:30px;
    font-weight:bold;
}

section{
    padding:60px 10%;
}

h2{
    text-align:center;
    margin-bottom:30px;
}

.about{
    text-align:center;
    line-height:1.8;
}

.skills{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:20px;
}

.skill{
    background:white;
    padding:20px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 5px 10px rgba(0,0,0,.1);
}

.projects{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 5px 10px rgba(0,0,0,.1);
}

.contact{
    text-align:center;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:20px;
}
</style>

</head>
<body>

<header>
    <h2>My Portfolio</h2>

    <nav>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero">
    <h1>Hello, I'm John Doe</h1>
    <p>Web Developer | Designer | Student</p>
    <a href="#projects" class="btn">View Projects</a>
</section>

<section id="about">
    <h2>About Me</h2>

    <div class="about">
        <p>
            I'm a passionate web developer who enjoys creating
            beautiful and responsive websites using HTML, CSS,
            JavaScript, and modern web technologies.
        </p>
    </div>
</section>

<section id="skills">
    <h2>Skills</h2>

    <div class="skills">
        <div class="skill">HTML</div>
        <div class="skill">CSS</div>
        <div class="skill">JavaScript</div>
        <div class="skill">Bootstrap</div>
        <div class="skill">React</div>
        <div class="skill">Python</div>
    </div>
</section>

<section id="projects">
    <h2>Projects</h2>

    <div class="projects">

        <div class="card">
            <h3>Portfolio Website</h3>
            <p>Responsive personal portfolio using HTML and CSS.</p>
        </div>

        <div class="card">
            <h3>Calculator</h3>
            <p>Simple calculator built using JavaScript.</p>
        </div>

        <div class="card">
            <h3>Weather App</h3>
            <p>Weather application using API integration.</p>
        </div>

    </div>
</section>

<section id="contact">
    <h2>Contact</h2>

    <div class="contact">
        <p>Email: yourname@email.com</p>
        <p>Phone: +91 9876543210</p>
        <p>GitHub: github.com/yourusername</p>
    </div>
</section>

<footer>
    <p>© 2026 My Portfolio. All Rights Reserved.</p>
</footer>

</body>
</html>
